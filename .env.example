# PostgreSQL / PostGIS
POSTGRES_USER=apartment_hunter
POSTGRES_PASSWORD=changeme
POSTGRES_DB=apartment_hunting
POSTGRES_HOST=localhost
# 5433, not 5432: this machine already runs a native postgresql@14 service on 5432
POSTGRES_PORT=5433

# SQLAlchemy connection strings (async for app runtime, sync for Alembic)
DATABASE_URL=postgresql+asyncpg://apartment_hunter:changeme@localhost:5433/apartment_hunting
DATABASE_URL_SYNC=postgresql+psycopg2://apartment_hunter:changeme@localhost:5433/apartment_hunting

# Mapbox (Phase 3)
MAPBOX_ACCESS_TOKEN=

# Bright Data Facebook Marketplace scraper (Phase 4) — https://brightdata.com/cp/api_tokens
BRIGHTDATA_API_KEY=

# Twilio (Phase 5)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
