VITE_API_BASE_URL=http://localhost:8000
VITE_MAPBOX_ACCESS_TOKEN=

# Dev-only toggles to conserve Mapbox free-tier usage while iterating:
# - Set to "false" to skip live map loads (shows a placeholder instead).
VITE_MAPBOX_ENABLED=true
# - Set to "true" to serve listings from a local fixture instead of the backend API.
VITE_USE_MOCK_LISTINGS=false
